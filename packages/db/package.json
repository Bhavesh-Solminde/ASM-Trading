{
  "name": "@asm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:fraud": "dotenv -e ../../.env -- tsx prisma/seed-fraud.ts",
    "seed:algo": "dotenv -e ../../.env -- tsx prisma/seed-algo.ts",
    "seed:approvals": "dotenv -e ../../.env -- tsx prisma/seed-approvals-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@asm/algo": "workspace:*",
    "@asm/config": "workspace:*",
    "@asm/logger": "workspace:*",
    "@asm/trading": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "dotenv-cli": "10.0.0",
    "prisma": "7.10.0",
    "tsx": "4.20.6"
  }
}

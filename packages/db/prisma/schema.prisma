generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  LIVE
  DEMO
}

enum LifecycleStage {
  PRE_DEPOSIT
  DEPOSITED
  HIGH_VALUE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

/// Account lifecycle from a compliance/anti-fraud standpoint. Kept separate
/// from KycStatus so a KYC-verified user can still be frozen for abuse, and
/// a fresh user can be flagged before KYC even starts. Order matters: any
/// non-ACTIVE status blocks bonus grants, new trades, and withdrawals.
enum UserStatus {
  ACTIVE
  FLAGGED
  FROZEN
  BANNED
}

/// What kind of fraud a FraudFlag records. LINKED_ACCOUNT is the multi-account
/// bonus-abuse pattern (same signup IP / device / deposit method across users).
/// HEDGING is opposite trades on linked accounts within a short window.
enum FraudFlagKind {
  LINKED_ACCOUNT
  HEDGING
  SHARED_WITHDRAWAL_METHOD
  RAPID_MULTI_ACCOUNT
}

enum FraudFlagStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum AssetKind {
  REAL
  OTC
}

enum Direction {
  UP
  DOWN
}

enum TradeStatus {
  OPEN
  WON
  LOST
  REFUNDED
}

enum DepositStatus {
  AWAITING_PAYMENT
  PENDING_CONFIRMATION
  COMPLETED
  REJECTED
  EXPIRED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

/// A USDT on-chain transfer's own confirmation lifecycle — an SMS/UPI credit
/// never needed this (it's instant), but a blockchain transfer genuinely does.
/// FAILED_ON_CHAIN is checked independently even though a decoded Transfer
/// event structurally can't come from a reverted call (the TVM discards logs
/// on revert, same as the EVM) — "observed" is never treated as proof
/// "safe to credit" on its own; see matchChainCreditToDeposit and the design
/// doc this implements (2026-09-27 USDT deposit plan).
enum ChainCreditFinalityState {
  DETECTED
  CONFIRMING
  FINAL
  FAILED_ON_CHAIN
  REORGED
}

enum ChainCreditProcessingStatus {
  PENDING
  MATCHED
  MANUAL_REVIEW
  UNMATCHED
  // Terminal: an admin reviewed a MANUAL_REVIEW/UNMATCHED row and marked it
  // handled WITHOUT crediting anyone (refunded off-platform, spam/dust, etc.).
  // Always set together with consumed = true (see dismissChainCredit).
  DISMISSED
}

enum TxKind {
  DEPOSIT
  WITHDRAWAL
  TRADE_STAKE
  TRADE_PAYOUT
  TRADE_REFUND
  BONUS_GRANT
  BONUS_CONVERT
  DEMO_RESET
  CURRENCY_CONVERT
}

/// House-governor verdict stamped on Trade at open time. WIN/LOSS drive the
/// per-trade magnet; HONEST means no bias (demo, or governor flag off).
enum TradeVerdict {
  WIN
  LOSS
  HONEST
}

/// Shape of the price journey from entry to target. DIRECT ramps smoothly.
/// OSCILLATE wanders near entry for the first 60% then converges. FEINT
/// drives opposite for the first 35% (feels like a fake-out) then reverses.
enum PathStyle {
  DIRECT
  OSCILLATE
  FEINT
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  role               Role       @default(USER)
  emailVerified      Boolean    @default(false)
  // Per-user gate for the real-money LIVE account. Default false keeps live
  // trading closed for everyone; granted individually (seed test users, or the
  // admin Users panel) so exposure is never global. The client env flag
  // NEXT_PUBLIC_LIVE_ACCOUNT_ENABLED can still open it for everyone at once.
  liveAccess         Boolean    @default(false)
  twoFaEnabled       Boolean    @default(false)
  twoFaForLogin      Boolean    @default(false)
  twoFaForWithdrawal Boolean    @default(false)
  nickname           String?
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime?
  aadhaar            String?
  address            String?
  country            String?
  kycStatus          KycStatus  @default(NOT_STARTED)
  cumulativeDeposits Int        @default(0)
  isBot              Boolean    @default(false)
  // Compliance/anti-fraud status. A non-ACTIVE status blocks new trades,
  // bonus grants and withdrawals; the status is set by the linked-accounts
  // detector or an admin action, never by the user's own flow.
  status             UserStatus @default(ACTIVE)
  statusReason       String?
  statusChangedAt    DateTime?
  // Captured at signup, updated on every session refresh. The pair drives the
  // linked-accounts detector and gives admin review a per-user forensics trail.
  // Nullable because pre-existing users have no capture history.
  signupIp           String?
  signupUserAgent    String?
  signupDeviceFp     String?
  lastIp             String?
  lastUserAgent      String?
  lastSeenAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts       Account[]
  sessions       Session[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
  supportTickets SupportTicket[]
  twoFactorCodes TwoFactorCode[]
  fraudFlags     FraudFlag[]

  @@index([email])
  // The detector queries these hot; a plain btree on a nullable String is
  // still cheap and NULL rows never enter the index scan.
  @@index([signupIp])
  @@index([lastIp])
  @@index([status])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String          @id @default(uuid())
  userId            String
  type              AccountType
  currency          String          @default("INR")
  realBalance       Int             @default(0)
  bonusBalance      Int             @default(0)
  turnoverProgress  Int             @default(0)
  lifecycleStage    LifecycleStage  @default(PRE_DEPOSIT)
  rollingWinRate    Float           @default(0)
  tradesCount       Int             @default(0)
  medianStake       Int             @default(100)
  lossStreak        Int             @default(0)
  winStreak         Int             @default(0)
  lifecycleOverride LifecycleStage?
  dailyLimit        Int?
  version           Int             @default(0)
  createdAt         DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades       Trade[]
  transactions Transaction[]
  bonusGrants  BonusGrant[]

  @@unique([userId, type])
  @@index([userId])
}

model Asset {
  id          String    @id @default(uuid())
  symbol      String    @unique
  displayName String
  kind        AssetKind
  payoutPct   Int       @default(100)
  payoutMin   Int       @default(100)
  payoutMax   Int       @default(100)
  isOpen      Boolean   @default(true)
  tickSize    Float     @default(0.00001)
  precision   Int       @default(5)
  basePrice   Float     @default(1.0)
  garchOmega  Float     @default(0.00000001)
  garchAlpha  Float     @default(0.08)
  garchBeta   Float     @default(0.90)
  anchorAlpha Float     @default(0.08)
  createdAt   DateTime  @default(now())

  candles Candle[]
  trades  Trade[]
}

model Candle {
  assetId   String
  timeframe String
  openTs    DateTime
  o         Float
  h         Float
  l         Float
  c         Float
  shadowO   Float?
  shadowH   Float?
  shadowL   Float?
  shadowC   Float?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, timeframe, openTs])
  @@index([assetId, timeframe, openTs])
}

model Trade {
  id             String      @id @default(uuid())
  accountId      String
  assetId        String
  direction      Direction
  stake          Int
  /// The part of `stake` drawn from bonusBalance. Settlement credits return in this proportion.
  stakeFromBonus Int         @default(0)
  payoutPct      Int
  entryPrice     Float
  entryTs        DateTime
  expiryTs       DateTime
  exitPrice      Float?
  status         TradeStatus @default(OPEN)
  pnl            Int         @default(0)
  createdAt      DateTime    @default(now())

  /// House-governor fields — stamped at open on live trades; null for
  /// pre-existing rows and demo trades (grandfathered as HONEST at read).
  /// targetPrice uses the same Float scale as entryPrice/exitPrice.
  verdict     TradeVerdict?
  pathStyle   PathStyle?
  targetPrice Float?

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset        @relation(fields: [assetId], references: [id])
  shadow  TradeShadow?

  @@index([accountId, createdAt])
  @@index([expiryTs, status])
}

/// Per-IST-day house ledger. Written by the settlement path on every non-DEMO
/// trade. Drives the governor's win-probability ladder.
model HouseDay {
  date                DateTime @id @db.Date
  targetProfitMinor   Int
  realizedProfitMinor Int      @default(0)
  totalStakesMinor    Int      @default(0)
  totalPayoutsMinor   Int      @default(0)
  tradesSettled       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Cumulative house treasury for the Growth-Loop Governor (GLG). Singleton row
/// (id = 1). Never resets on a calendar boundary: house profit accumulates
/// forever, and pWin is a piecewise-linear function of `treasuryMinor` divided
/// by `treasuryTargetMinor`. Written by the settlement path on every non-DEMO
/// trade when `USE_GLG_TREASURY` is on. Read once per trade open.
model HouseTreasury {
  id                  Int      @id @default(1)
  treasuryMinor       Int      @default(0)
  treasuryTargetMinor Int      @default(1000000)
  updatedAt           DateTime @updatedAt
}

/// Recorded for every settled trade, never exposed to a trading client.
model TradeShadow {
  tradeId          String   @id
  shownExitPrice   Float
  honestExitPrice  Float
  shownResult      String
  honestResult     String
  deltaPips        Float
  biasApplied      Float
  magnetApplied    Float
  imbalanceAtEntry Float
  exposureUp       Int
  exposureDown     Int
  lifecycleStage   String
  wantedWin        Boolean?
  winProbability   Float?
  createdAt        DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ShadowTick {
  id          BigInt   @id @default(autoincrement())
  assetId     String
  ts          DateTime
  shownPrice  Float
  honestPrice Float

  @@index([assetId, ts])
}

model Deposit {
  id              String        @id @default(uuid())
  userId          String
  method          String
  amountUsd       Int
  amountInr       Int
  vpa             String
  checkoutToken   String        @unique
  claimedUtr      String?
  status          DepositStatus @default(AWAITING_PAYMENT)
  matchedCreditId String?
  correlationId   String
  expiresAt       DateTime
  // Optional user-submitted proof of payment: a screenshot from their UPI app,
  // uploaded to Cloudinary from the browser. We store only the secure_url; the
  // image itself lives in Cloudinary. Only present when the user attached one
  // at UTR-submission time; auto-matched deposits never touch this column.
  screenshotUrl   String?
  // IP + UA at the moment the deposit was requested. Fed to the linked-
  // accounts detector alongside signup IP so a fresh account depositing from
  // an IP that already has a completed deposit under a different user is
  // linkable even if signup came from a different network.
  ipAddress       String?
  userAgent       String?
  // ── USDT (TRC-20) fields — all nullable, unused by the INR/UPI path ──
  // network/tokenContract/receivingAddress are denormalized display fields
  // (the live config is re-verified at match time regardless — see
  // matchChainCreditToDeposit; these are never trusted as authoritative).
  network         String?
  tokenContract   String?
  receivingAddress String?
  // Reserved AND credited amount, in USDT-cents (2dp) — deliberately the same
  // precision Account.realBalance already uses for every other currency, not
  // the token's native 6dp. See usdt-money.ts and the design doc's precision
  // section for why 6dp would silently overflow Int32 balances and lose
  // sub-cent value the ledger has nowhere to put.
  amountUsdtMinor Int?
  matchedChainCreditId String? @unique
  // Set only by the USDT matcher when this deposit lands in manual review.
  // Nothing else in this codebase populates this today — the INR path has no
  // equivalent field and is not being retrofitted with one here.
  reviewReason    String?
  // USDT only: the transaction hash the user SAYS paid this deposit ("I
  // already paid"), 64 lowercase hex chars, no 0x. Evidence for an admin
  // reviewing an unmatched ChainCredit — NEVER a match key and never credits
  // anything. A tx hash is public on-chain, so anyone can claim anyone's
  // hash: deliberately NOT unique (a fraudulent claim must not block the real
  // payer from claiming too). Indexed for the admin's claim lookup by hash.
  claimedTxHash   String?
  // ── Payment-gateway (Tatum) fields — null on every legacy/manual row ──
  // "TATUM" when this deposit was issued its OWN receiving address derived
  // from the gateway's HD-wallet xpub. Such deposits are matched by address,
  // never by amount, so they are excluded from both live-amount partial
  // unique indexes (see 20261005120000_tatum_gateway/migration.sql).
  gateway               String?
  // HD derivation index the receivingAddress was derived at (>= 1 per network).
  gatewayAddressIndex   Int?
  // Tatum INCOMING_FUNGIBLE_TX alert id watching receivingAddress; deleted
  // (best-effort) once the deposit closes.
  gatewaySubscriptionId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOTE: the amount-reservation guarantee is enforced by a PARTIAL unique
  // index — unique on (amountInr) ALONE, WHERE status IN ('AWAITING_PAYMENT',
  // 'PENDING_CONFIRMATION'). Prisma cannot express that declaratively, so a
  // hand-written migration adds it (see
  // 20260913172607_add_relay_message_and_amount_reservation/migration.sql).
  // A plain @@unique here would be wrong: it would block two legitimate
  // COMPLETED deposits that happened to share an amount months apart.
  //
  // VPA plays no role in this guarantee, or in credit matching at all (see
  // matchCreditToDeposit) — every deposit shares one fixed demo VPA
  // (DEMO_VPA); it's used only to build the QR/UPI deep link, never as a
  // matching key. The @@index below predates that design correction and is
  // now mostly redundant: its leading column, vpa, is never used as a query
  // predicate anywhere in the codebase, so it can't serve the queries that
  // matter either. Left in place — dropping it is a real schema change
  // (its own migration) and out of scope here.
  @@index([vpa, amountInr, status])
  @@index([userId, createdAt])
  @@index([status])
  @@index([claimedTxHash])
  @@unique([gateway, network, gatewayAddressIndex])
  @@index([gateway, network, receivingAddress])
  // USDT gets its OWN partial unique index on amountUsdtMinor, hand-written in
  // the same migration as the column additions (Prisma can't express a
  // partial index declaratively) — see
  // <migration>_add_usdt_chain_credit/migration.sql. A separate index from
  // Deposit_live_amount_unique: paise and USDT-cents are different unit
  // spaces and must never collide with each other.
}

/// Next HD derivation index per network for gateway (Tatum) deposit
/// addresses. Allocated with one atomic increment so two concurrent deposits
/// can never be handed the same address. Index 0 is reserved (never issued).
model GatewayAddressCounter {
  network   String @id
  nextIndex Int
  updatedAt DateTime @updatedAt
}

/// Stands in for a bank statement. Populated by whichever BankFeed is configured.
model BankCredit {
  id         String   @id @default(uuid())
  vpa        String
  amountInr  Int
  utr        String   @unique
  receivedAt DateTime
  raw        String?
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  relayMessages RelayMessage[]

  @@index([vpa, amountInr, consumed])
}

/// Raw log of every incoming message from any companion app/device, whether
/// or not it turned out to be a usable credit. BankCredit is reserved for
/// messages that parsed as an actual credit; this table is the full record.
model RelayMessage {
  id              String   @id @default(uuid())
  source          String
  deviceLabel     String?
  deviceModel     String?
  sender          String?
  body            String
  receivedAt      DateTime
  parsedAmountInr Int?
  parsedUtr       String?
  isCredit        Boolean?
  bankCreditId    String?
  createdAt       DateTime @default(now())

  bankCredit BankCredit? @relation(fields: [bankCreditId], references: [id], onDelete: SetNull)

  @@index([source, deviceLabel])
  @@index([createdAt])
}

/// The BankCredit analog for a USDT on-chain transfer (network "tron" TRC-20
/// or "bsc" BEP-20; EVM hashes/addresses stored lowercase 0x-prefixed; for
/// "bsc" eventIndex is the receipt's logIndex) — deliberately
/// a separate model rather than a generalized BankCredit, since utr there is
/// a required unique string with no network/contract/event columns, and
/// retrofitting it risks the working SMS path for no benefit.
///
/// Event identity: eventIndex is "the event's index within the transaction's
/// event log" (TronGrid's own field, resolved via
/// GET /v1/transactions/{txHash}/events — never assumed, never defaulted to
/// 0). That position is already unique within a transaction across every
/// contract that emitted anything in it, so (network, txHash, eventIndex)
/// alone would be a sufficient identity; tokenContract is included in the
/// unique constraint anyway as defense-in-depth, so a bug that resolves the
/// wrong contract's event for a given (txHash, eventIndex) fails a
/// constraint instead of silently colliding into an existing row.
model ChainCredit {
  id            String   @id @default(uuid())
  network       String
  tokenContract String
  txHash        String
  eventIndex    Int
  fromAddress   String
  toAddress     String
  // The true on-chain value in the token's own base units (tokenDecimals dp),
  // never rounded/truncated — lossless evidence. NUMERIC(78,0) holds any
  // uint256: an 18-decimal token (BSC USDT) overflows int8 above ~9.2 tokens.
  // Prisma returns a Decimal; read it exactly with BigInt(rawAmount.toFixed(0)).
  // See usdt-money.ts for the exact (raw <-> normalized) integer conversion
  // and why normalizedAmountMinor is nullable.
  rawAmount     Decimal  @db.Decimal(78, 0)
  // The token's decimals() at ingestion (TRON USDT 6, BSC USDT 18).
  tokenDecimals Int      @default(6)
  // 2dp (USDT-cents), null when rawAmount isn't an exact multiple of
  // 10^(tokenDecimals-2) — i.e. genuinely not representable at this app's
  // accounting precision.
  // Never coerced/rounded into a value; a null here always routes to
  // MANUAL_REVIEW/PRECISION_NOT_REPRESENTABLE, never silently dropped.
  normalizedAmountMinor Int?
  blockNumber     BigInt
  blockTimestamp  DateTime
  finalityState   ChainCreditFinalityState @default(DETECTED)
  processingStatus ChainCreditProcessingStatus @default(PENDING)
  // Enumerated reason codes: AMBIGUOUS_AMOUNT, PRECISION_NOT_REPRESENTABLE,
  // AMBIGUOUS_EVENT_WITHIN_TRANSACTION, WRONG_TOKEN_CONTRACT, WRONG_NETWORK,
  // WRONG_DESTINATION, EXPIRED_DEPOSIT, NO_LIVE_DEPOSIT.
  reviewReason    String?
  // Guard field creditDepositToAccount flips atomically alongside
  // processingStatus->MATCHED and Deposit.status->COMPLETED — the same
  // update-then-count idiom BankCredit.consumed already uses. Once true,
  // never reused for a different deposit (see the one-credit-only guarantee
  // in the design doc).
  consumed        Boolean  @default(false)
  // Finality poller's own bookkeeping (the strict multi-signal reorg
  // criteria: >=3 consecutive not-found checks AND >=10 minutes elapsed AND
  // also missing on the full node — never set from one transient response).
  lastCheckedAt   DateTime?
  checkAttempts   Int      @default(0)
  firstNotFoundAt DateTime?
  // Full provider response(s) — audit/evidence only. Matching and crediting
  // code never reads this; only the normalized fields above are the
  // accounting-relevant representation.
  rawPayload      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([network, tokenContract, txHash, eventIndex])
  @@index([processingStatus])
  @@index([finalityState])
  @@index([network, tokenContract, toAddress, normalizedAmountMinor])
}

/// Durable pagination state for the USDT chain watcher's discovery scan.
/// version is the same optimistic-concurrency idiom Account.version already
/// uses elsewhere in this codebase — it's what stops two concurrent watcher
/// instances from both advancing (or corrupting) the same cursor row for one
/// tick; the loser just no-ops and re-reads fresh next tick.
///
/// activeSession* fields are non-null only while a pagination session (a
/// bounded [min,max] timestamp window, walked page-by-page via TronGrid's
/// fingerprint) is in progress. lastCommittedTimestampMs — the durable safe
/// floor — only ever advances once a session's EVERY page has been
/// persisted; see the design doc's pagination/checkpoint section for why a
/// bare timestamp cursor alone is not sufficient and the fingerprint must be
/// treated as the actual resumption identity.
model ChainScanCursor {
  network                     String
  tokenContract               String
  receivingAddress            String
  lastCommittedTimestampMs    BigInt
  activeSessionMinTimestampMs BigInt?
  activeSessionMaxTimestampMs BigInt?
  activeSessionFingerprint    String?
  // EVM (BSC) block cursor: the highest block whose logs are durably
  // ingested AND finalized. TRON rows leave it null; EVM rows keep
  // lastCommittedTimestampMs = 0 and never open a session.
  lastScannedBlock            BigInt?
  version                     Int      @default(0)
  updatedAt                   DateTime @updatedAt

  @@id([network, tokenContract, receivingAddress])
}

model Withdrawal {
  id         String           @id @default(uuid())
  userId     String
  amount     Int
  method     String
  status     WithdrawalStatus @default(REQUESTED)
  reviewedBy String?
  reason     String?
  // Same forensics rationale as Deposit.ipAddress/userAgent.
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // Cross-user dedup query: "has any other user withdrawn to this method?"
  // The predicate hits (method, userId) so a composite covers both the
  // dedup lookup and any per-user history filter.
  @@index([method, userId])
}

/// Append-only ledger. Every balance change writes exactly one row.
model Transaction {
  id           String   @id @default(uuid())
  accountId    String
  kind         TxKind
  amount       Int
  balanceAfter Int
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model BonusGrant {
  id               String   @id @default(uuid())
  accountId        String
  amount           Int
  turnoverRequired Int
  turnoverDone     Int      @default(0)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Append-only. UPDATE and DELETE are revoked from the runtime role.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  subject   String
  body      String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A single fraud-detector finding, awaiting an admin decision. The detector
/// is deliberately non-authoritative: it never freezes an account on its own
/// (a shared household IP is a common false positive), it writes a flag with
/// full evidence and lets an admin decide. `linkedUserIds` is the group of
/// user IDs the detector considered related — the flag belongs to one of them
/// so it appears in that user's admin view, but the full group is preserved
/// so the operator can act on all of them from one screen.
model FraudFlag {
  id            String          @id @default(uuid())
  userId        String
  kind          FraudFlagKind
  status        FraudFlagStatus @default(OPEN)
  /// One JSON blob with all fields that led the detector to raise this flag —
  /// IPs, UAs, deposit methods, matched user IDs, correlation windows.
  /// Untyped so evidence can evolve without a migration; typed on read at
  /// the admin UI.
  evidence      Json
  linkedUserIds String[]
  reviewedBy    String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([kind, status])
}

/// Short-lived one-time codes for two-factor login and withdrawal. The code is
/// delivered to the log (no SMTP/provider in this build); only its hash is
/// stored, and `usedAt` makes redemption single-use.
model TwoFactorCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// USDT reconciliation (Phase 7): a read-only background check that verifies
/// the USDT deposit/ChainCredit invariants and raises findings. Populated
/// exclusively by runUsdtReconciliation() in repositories/reconciliation.ts —
/// nothing else writes to this table, and this table is never read by any
/// crediting/matching code path (it observes, never participates).
enum ReconciliationSeverity {
  P1
  WARNING
}

enum ReconciliationIssueStatus {
  OPEN
  RESOLVED
}

model ReconciliationIssue {
  id              String                    @id @default(uuid())
  checkName       String
  severity        ReconciliationSeverity
  network         String
  subjectType     String
  subjectId       String
  message         String
  status          ReconciliationIssueStatus @default(OPEN)
  firstDetectedAt DateTime                  @default(now())
  lastSeenAt      DateTime                  @updatedAt
  resolvedAt      DateTime?

  @@unique([checkName, subjectType, subjectId])
  @@index([status, severity])
  @@index([checkName])
}

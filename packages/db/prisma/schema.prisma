generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  LIVE
  DEMO
}

enum LifecycleStage {
  PRE_DEPOSIT
  DEPOSITED
  HIGH_VALUE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

/// Account lifecycle from a compliance/anti-fraud standpoint. Kept separate
/// from KycStatus so a KYC-verified user can still be frozen for abuse, and
/// a fresh user can be flagged before KYC even starts. Order matters: any
/// non-ACTIVE status blocks bonus grants, new trades, and withdrawals.
enum UserStatus {
  ACTIVE
  FLAGGED
  FROZEN
  BANNED
}

/// What kind of fraud a FraudFlag records. LINKED_ACCOUNT is the multi-account
/// bonus-abuse pattern (same signup IP / device / deposit method across users).
/// HEDGING is opposite trades on linked accounts within a short window.
enum FraudFlagKind {
  LINKED_ACCOUNT
  HEDGING
  SHARED_WITHDRAWAL_METHOD
  RAPID_MULTI_ACCOUNT
}

enum FraudFlagStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum AssetKind {
  REAL
  OTC
}

enum Direction {
  UP
  DOWN
}

enum TradeStatus {
  OPEN
  WON
  LOST
  REFUNDED
}

enum DepositStatus {
  AWAITING_PAYMENT
  PENDING_CONFIRMATION
  COMPLETED
  REJECTED
  EXPIRED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum TxKind {
  DEPOSIT
  WITHDRAWAL
  TRADE_STAKE
  TRADE_PAYOUT
  TRADE_REFUND
  BONUS_GRANT
  BONUS_CONVERT
  DEMO_RESET
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  role               Role       @default(USER)
  emailVerified      Boolean    @default(false)
  // Per-user gate for the real-money LIVE account. Default false keeps live
  // trading closed for everyone; granted individually (seed test users, or the
  // admin Users panel) so exposure is never global. The client env flag
  // NEXT_PUBLIC_LIVE_ACCOUNT_ENABLED can still open it for everyone at once.
  liveAccess         Boolean    @default(false)
  twoFaEnabled       Boolean    @default(false)
  twoFaForLogin      Boolean    @default(false)
  twoFaForWithdrawal Boolean    @default(false)
  nickname           String?
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime?
  aadhaar            String?
  address            String?
  country            String?
  kycStatus          KycStatus  @default(NOT_STARTED)
  cumulativeDeposits Int        @default(0)
  isBot              Boolean    @default(false)
  // Compliance/anti-fraud status. A non-ACTIVE status blocks new trades,
  // bonus grants and withdrawals; the status is set by the linked-accounts
  // detector or an admin action, never by the user's own flow.
  status             UserStatus @default(ACTIVE)
  statusReason       String?
  statusChangedAt    DateTime?
  // Captured at signup, updated on every session refresh. The pair drives the
  // linked-accounts detector and gives admin review a per-user forensics trail.
  // Nullable because pre-existing users have no capture history.
  signupIp           String?
  signupUserAgent    String?
  signupDeviceFp     String?
  lastIp             String?
  lastUserAgent      String?
  lastSeenAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts       Account[]
  sessions       Session[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
  supportTickets SupportTicket[]
  twoFactorCodes TwoFactorCode[]
  fraudFlags     FraudFlag[]

  @@index([email])
  // The detector queries these hot; a plain btree on a nullable String is
  // still cheap and NULL rows never enter the index scan.
  @@index([signupIp])
  @@index([lastIp])
  @@index([status])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String          @id @default(uuid())
  userId            String
  type              AccountType
  currency          String          @default("INR")
  realBalance       Int             @default(0)
  bonusBalance      Int             @default(0)
  turnoverProgress  Int             @default(0)
  lifecycleStage    LifecycleStage  @default(PRE_DEPOSIT)
  rollingWinRate    Float           @default(0)
  tradesCount       Int             @default(0)
  medianStake       Int             @default(100)
  lossStreak        Int             @default(0)
  winStreak         Int             @default(0)
  lifecycleOverride LifecycleStage?
  dailyLimit        Int?
  version           Int             @default(0)
  createdAt         DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades       Trade[]
  transactions Transaction[]
  bonusGrants  BonusGrant[]

  @@unique([userId, type])
  @@index([userId])
}

model Asset {
  id          String    @id @default(uuid())
  symbol      String    @unique
  displayName String
  kind        AssetKind
  payoutPct   Int       @default(100)
  payoutMin   Int       @default(100)
  payoutMax   Int       @default(100)
  isOpen      Boolean   @default(true)
  tickSize    Float     @default(0.00001)
  precision   Int       @default(5)
  basePrice   Float     @default(1.0)
  garchOmega  Float     @default(0.00000001)
  garchAlpha  Float     @default(0.08)
  garchBeta   Float     @default(0.90)
  anchorAlpha Float     @default(0.08)
  createdAt   DateTime  @default(now())

  candles Candle[]
  trades  Trade[]
}

model Candle {
  assetId   String
  timeframe String
  openTs    DateTime
  o         Float
  h         Float
  l         Float
  c         Float
  shadowO   Float?
  shadowH   Float?
  shadowL   Float?
  shadowC   Float?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, timeframe, openTs])
  @@index([assetId, timeframe, openTs])
}

model Trade {
  id             String      @id @default(uuid())
  accountId      String
  assetId        String
  direction      Direction
  stake          Int
  /// The part of `stake` drawn from bonusBalance. Settlement credits return in this proportion.
  stakeFromBonus Int         @default(0)
  payoutPct      Int
  entryPrice     Float
  entryTs        DateTime
  expiryTs       DateTime
  exitPrice      Float?
  status         TradeStatus @default(OPEN)
  pnl            Int         @default(0)
  createdAt      DateTime    @default(now())

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset        @relation(fields: [assetId], references: [id])
  shadow  TradeShadow?

  @@index([accountId, createdAt])
  @@index([expiryTs, status])
}

/// Recorded for every settled trade, never exposed to a trading client.
model TradeShadow {
  tradeId          String   @id
  shownExitPrice   Float
  honestExitPrice  Float
  shownResult      String
  honestResult     String
  deltaPips        Float
  biasApplied      Float
  magnetApplied    Float
  imbalanceAtEntry Float
  exposureUp       Int
  exposureDown     Int
  lifecycleStage   String
  wantedWin        Boolean?
  winProbability   Float?
  createdAt        DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ShadowTick {
  id          BigInt   @id @default(autoincrement())
  assetId     String
  ts          DateTime
  shownPrice  Float
  honestPrice Float

  @@index([assetId, ts])
}

model Deposit {
  id              String        @id @default(uuid())
  userId          String
  method          String
  amountUsd       Int
  amountInr       Int
  vpa             String
  checkoutToken   String        @unique
  claimedUtr      String?
  status          DepositStatus @default(AWAITING_PAYMENT)
  matchedCreditId String?
  correlationId   String
  expiresAt       DateTime
  // IP + UA at the moment the deposit was requested. Fed to the linked-
  // accounts detector alongside signup IP so a fresh account depositing from
  // an IP that already has a completed deposit under a different user is
  // linkable even if signup came from a different network.
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOTE: the amount-reservation guarantee is enforced by a PARTIAL unique
  // index — unique on (amountInr) ALONE, WHERE status IN ('AWAITING_PAYMENT',
  // 'PENDING_CONFIRMATION'). Prisma cannot express that declaratively, so a
  // hand-written migration adds it (see
  // 20260913172607_add_relay_message_and_amount_reservation/migration.sql).
  // A plain @@unique here would be wrong: it would block two legitimate
  // COMPLETED deposits that happened to share an amount months apart.
  //
  // VPA plays no role in this guarantee, or in credit matching at all (see
  // matchCreditToDeposit) — every deposit shares one fixed demo VPA
  // (DEMO_VPA); it's used only to build the QR/UPI deep link, never as a
  // matching key. The @@index below predates that design correction and is
  // now mostly redundant: its leading column, vpa, is never used as a query
  // predicate anywhere in the codebase, so it can't serve the queries that
  // matter either. Left in place — dropping it is a real schema change
  // (its own migration) and out of scope here.
  @@index([vpa, amountInr, status])
  @@index([userId, createdAt])
  @@index([status])
}

/// Stands in for a bank statement. Populated by whichever BankFeed is configured.
model BankCredit {
  id         String   @id @default(uuid())
  vpa        String
  amountInr  Int
  utr        String   @unique
  receivedAt DateTime
  raw        String?
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  relayMessages RelayMessage[]

  @@index([vpa, amountInr, consumed])
}

/// Raw log of every incoming message from any companion app/device, whether
/// or not it turned out to be a usable credit. BankCredit is reserved for
/// messages that parsed as an actual credit; this table is the full record.
model RelayMessage {
  id              String   @id @default(uuid())
  source          String
  deviceLabel     String?
  deviceModel     String?
  sender          String?
  body            String
  receivedAt      DateTime
  parsedAmountInr Int?
  parsedUtr       String?
  isCredit        Boolean?
  bankCreditId    String?
  createdAt       DateTime @default(now())

  bankCredit BankCredit? @relation(fields: [bankCreditId], references: [id], onDelete: SetNull)

  @@index([source, deviceLabel])
  @@index([createdAt])
}

model Withdrawal {
  id         String           @id @default(uuid())
  userId     String
  amount     Int
  method     String
  status     WithdrawalStatus @default(REQUESTED)
  reviewedBy String?
  reason     String?
  // Same forensics rationale as Deposit.ipAddress/userAgent.
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // Cross-user dedup query: "has any other user withdrawn to this method?"
  // The predicate hits (method, userId) so a composite covers both the
  // dedup lookup and any per-user history filter.
  @@index([method, userId])
}

/// Append-only ledger. Every balance change writes exactly one row.
model Transaction {
  id           String   @id @default(uuid())
  accountId    String
  kind         TxKind
  amount       Int
  balanceAfter Int
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model BonusGrant {
  id               String   @id @default(uuid())
  accountId        String
  amount           Int
  turnoverRequired Int
  turnoverDone     Int      @default(0)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Append-only. UPDATE and DELETE are revoked from the runtime role.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  subject   String
  body      String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A single fraud-detector finding, awaiting an admin decision. The detector
/// is deliberately non-authoritative: it never freezes an account on its own
/// (a shared household IP is a common false positive), it writes a flag with
/// full evidence and lets an admin decide. `linkedUserIds` is the group of
/// user IDs the detector considered related — the flag belongs to one of them
/// so it appears in that user's admin view, but the full group is preserved
/// so the operator can act on all of them from one screen.
model FraudFlag {
  id            String          @id @default(uuid())
  userId        String
  kind          FraudFlagKind
  status        FraudFlagStatus @default(OPEN)
  /// One JSON blob with all fields that led the detector to raise this flag —
  /// IPs, UAs, deposit methods, matched user IDs, correlation windows.
  /// Untyped so evidence can evolve without a migration; typed on read at
  /// the admin UI.
  evidence      Json
  linkedUserIds String[]
  reviewedBy    String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([kind, status])
}

/// Short-lived one-time codes for two-factor login and withdrawal. The code is
/// delivered to the log (no SMTP/provider in this build); only its hash is
/// stored, and `usedAt` makes redemption single-use.
model TwoFactorCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

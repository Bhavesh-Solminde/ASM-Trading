# asmtrader.com — production environment template.
# Copy to /opt/asmtrader/.env.production on the VPS, then replace every
# `change-me` value with an actual secret (e.g. `openssl rand -base64 32`).
# Never commit the filled version.

# --- Postgres (containerised, service name `postgres` on the compose network) ---
POSTGRES_DB=asm_trade
POSTGRES_OWNER_PASSWORD=change-me-owner-password
POSTGRES_APP_PASSWORD=change-me-app-password

# The app connects as asm_app (DML only); migrations run as asm_owner (DDL).
DATABASE_URL="postgresql://asm_app:change-me-app-password@postgres:5432/asm_trade?schema=public"
DATABASE_MIGRATE_URL="postgresql://asm_owner:change-me-owner-password@postgres:5432/asm_trade?schema=public"

# --- Redis (containerised, service name `redis`) ---
REDIS_URL="redis://redis:6379"

# --- Sessions / auth ---
SESSION_SECRET=change-me-32-bytes-minimum
ADMIN_PANEL_SECRET=change-me-admin-gate

# --- Bank feed (only "simulated" is configured today) ---
BANK_FEED=simulated
SMS_RELAY_SECRET=change-me-sms-relay

# --- Engine <-> web internal HTTP (docker network, not exposed to host) ---
ENGINE_HTTP_PORT=4002
ENGINE_HTTP_URL=http://engine:4002
ENGINE_INTERNAL_SECRET=change-me-engine-shared-secret

# --- Engine WebSocket (proxied by nginx as /ws) ---
ENGINE_WS_PORT=4001
# Baked into the Next.js client bundle at build time, so it must be set
# for the `web` build stage — see deploy/docker-compose.yml.
NEXT_PUBLIC_ENGINE_WS_URL=wss://asmtrader.com/ws

# Live account gate. Only "true" exposes the live account switcher; anything
# else keeps the client pinned to the demo account and shows a "coming soon"
# dialog. Baked into the Next.js client bundle at build time — the `web`
# build stage must see it (see deploy/docker-compose.yml). Rebuild after
# flipping.
NEXT_PUBLIC_LIVE_ACCOUNT_ENABLED=false

# Public site origin (no trailing slash) for canonicals, OpenGraph, sitemap
# and JSON-LD. Must be a NEXT_PUBLIC_* build-time var, so the build stage
# needs it (see deploy/docker-compose.yml). Rebuild after changing.
NEXT_PUBLIC_SITE_URL=https://asmtrader.com

# Google Search Console "HTML tag" verification token (CSP-safe <meta>).
# Leave empty if verifying via DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Live-Rates.com (forex + metals) ---
# socket.io v4, sub-second updates. Set this or forex/gold run fully synthetic.
# Grab a trial at https://www.live-rates.com/#trial.
LIVE_RATES_KEY=
# Optional regional endpoint (eu-wss / us-wss / as-wss). Default is geo-routed.
LIVE_RATES_ENDPOINT=

# --- Twelve Data (legacy — superseded by LIVE_RATES above, kept for rollback) ---
TWELVE_DATA_API_KEY=

# --- FYERS (NSE/BSE Indian indices) ---
# Dev-app credentials only. The per-day access token is captured via the
# browser OAuth round-trip at /api/integrations/fyers/authorize and stored in
# the IntegrationToken DB row — never in env, never in logs. REDIRECT_URI must
# match the URL registered in the FYERS app dashboard EXACTLY.
# Market-data redistribution to end users requires a separate NSE/BSE
# commercial agreement — this integration is for engine consumption only.
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=

# --- Bot crowd ---
BOTS_ENABLED=true
BOT_COUNT=40
BOT_ARRIVALS_PER_MINUTE=90

NODE_ENV=production
LOG_LEVEL=info

# Resend — transactional email. Sends: welcome (signup), password-reset link,
# "password changed" notice, deposit credited, withdrawal requested, withdrawal
# paid (reward certificate) and withdrawal rejected. Until RESEND_API_KEY is
# set the app runs unchanged and skips sending. RESEND_FROM must be on a domain
# verified in Resend; Resend's onboarding@resend.dev sandbox only delivers to
# the Resend account owner's own inbox. BOTH web and engine read these, because
# deposits are credited in both processes. Runbook: docs/email.md.
RESEND_API_KEY=
RESEND_FROM=IndianxTrade <no-reply@indianxtrade.com>
RESEND_REPLY_TO=support@indianxtrade.com

# =============================================================================
# USDT (TRC-20 + BEP-20) deposits — MAINNET, real money.
# Both the receiving addresses below are real; verify anything you change here
# against a live source before deploying, the same way every value here was
# verified (contract addresses, decimals, chain ids) — never guessed.
#
# CUSTODY: the private keys for both receiving addresses must live somewhere
# that is NOT this server — a hardware wallet, an exchange account, a separate
# signer. Nothing in this app ever needs a private key; it only watches public
# addresses. If a key for either address ends up in this file or on this box,
# that is the single biggest risk in this deployment — stop and fix that first.
#
# AUTO-CREDITING IS ON BY DECISION, NOT BY DEFAULT. USDT_AUTO_CONFIRM_ENABLED
# below is "true", meaning an exact-amount deposit on either network is
# credited the moment it's confirmed on-chain, with no human in the loop. Two
# real bugs were caught during testing before this was trusted with money (a
# currency-conversion bug that would have debited the wrong currency, and a
# bug that could have permanently orphaned a payment after an admin correction)
# — both were only caught because the system was watched closely before being
# fully trusted. Nothing here forces a delay, but seriously consider running
# with USDT_AUTO_CONFIRM_ENABLED=false for the first few real days so an admin
# approves each deposit once from /admin/deposits, before flipping it to true
# — same effect either way, this window just means a human sees the first
# batch of real mainnet activity before the system runs unattended. Also check
# /admin/reconciliation regularly (or as soon as it's set up to alert you) —
# it is the only thing watching for the automation getting something wrong
# after the fact.
# =============================================================================

# --- USDT deposit provider ---
# "tatum" (the default when unset) = Tatum payment gateway, one address per
# deposit (packages/tatum). "manual" = the shared-address flow configured by
# the USDT_* vars below. IMPORTANT: with "tatum" the manual watchers below do
# NOT run — so keep USDT_DEPOSIT_PROVIDER=manual on a server until every
# TATUM_* var is set for mainnet, or USDT disappears from the deposit page.
USDT_DEPOSIT_PROVIDER=manual
# Per-network override of the line above ("tatum" | "manual"). Production runs
# TRON on the shared treasury address (a per-deposit TRON address costs ~9.5 TRX
# to sweep) and BSC on per-deposit gateway addresses (sweeps cost cents):
USDT_BSC_PROVIDER=tatum
# USDT_TRON_PROVIDER=manual
# TRON (manual) time slots rotate across these client-owned addresses: each
# deposit holds one alone for 5 minutes. Comma-separated; falls back to
# USDT_RECEIVING_ADDRESS when empty.
USDT_RECEIVING_ADDRESSES=
# Tatum MAINNET API key (it starts with "t-" too) + TATUM_NETWORK=mainnet. xpubs only —
# mnemonics never live on this server. See .env.example for every var.
TATUM_API_KEY=
TATUM_NETWORK=mainnet
TATUM_TRON_XPUB=
TATUM_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TATUM_BSC_XPUB=
TATUM_BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
TATUM_BSC_USDT_DECIMALS=18
TATUM_WEBHOOK_URL=https://asmtrader.com/api/webhooks/tatum
TATUM_WEBHOOK_HMAC_SECRET=
TATUM_MAX_RPS=3
TATUM_TREASURY_TRON_ADDRESS=TL5cUNhJjPSmyZVDncznin7FrSTtea6zUG
TATUM_TREASURY_BSC_ADDRESS=0x15e770A42b41f2606538505839042ddFEBACB590

# --- TRON (TRC-20) ---
USDT_NETWORK=tron
# "mainnet" or "nile" (testnet) — exactly one of the two, nothing else, or the
# watcher stays idle rather than risk guessing which chain to use.
USDT_TRONGRID_NETWORK=mainnet
# Your real TRON receiving address. Verified as a well-formed, valid TRON
# address (queried live against TronGrid before this was written).
USDT_RECEIVING_ADDRESS=TL5cUNhJjPSmyZVDncznin7FrSTtea6zUG
# The canonical mainnet USDT-TRC20 contract (Tether's own — verified live:
# symbol "USDT", 6 decimals, ~$94B market cap at the time this was checked).
# Never change this to any other address without re-verifying the same way.
USDT_TOKEN_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TronGrid works without a key at a low rate limit, so TRON can technically
# run before this is set — but get a real key before real volume. Sign up at
# https://www.trongrid.io, create an API key, paste it here.
USDT_TRONGRID_API_KEY=change-me-trongrid-mainnet-api-key

# --- BNB Smart Chain (BEP-20) ---
# Exactly "56" (mainnet) or "97" (testnet) — nothing else, or the watcher
# stays idle. Never falls back to a default.
USDT_BSC_CHAIN_ID=56
# REQUIRED, and cannot be a placeholder that merely "looks" filled in: the
# official public BNB Chain RPC endpoints (bsc-dataseed.bnbchain.org and
# friends) REFUSE the exact call this app depends on (eth_getLogs) on both
# mainnet and testnet — verified live. A real provider is required, e.g.
# Ankr (ankr.com), Chainstack, or Alchemy — sign up, grab your BSC mainnet
# HTTPS endpoint URL, and put the whole URL (it may include a path-embedded
# key) here.
USDT_BSC_RPC_URL=change-me-bsc-mainnet-rpc-url-from-ankr-or-chainstack-or-alchemy
# Your real BSC receiving address. Verified as a well-formed address with a
# live eth_getBalance call before this was written.
USDT_BSC_RECEIVING_ADDRESS=0x15e770A42b41f2606538505839042ddFEBACB590
# The canonical mainnet USDT-BEP20 contract — verified live: symbol "USDT",
# 18 decimals. Never change this without re-verifying the same way.
USDT_BSC_TOKEN_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BSC_TOKEN_DECIMALS=18

# --- Shared by both networks ---
# The production-activation safety gate. true = an exact-amount deposit is
# credited automatically with no admin step; false = it still gets detected
# and matched, but waits for one admin click in /admin/deposits. See the
# block comment above before changing this.
USDT_AUTO_CONFIRM_ENABLED=true
# Sensible as-is; only change these if you have a specific reason to.
USDT_WATCHER_TICK_INTERVAL_MS=15000
USDT_WATCHER_IDLE_INTERVAL_MS=120000
USDT_OVERLAP_MS=600000
USDT_MAX_PAGES_PER_TICK=50
USDT_BSC_MAX_BLOCK_RANGE=2000
USDT_BSC_INITIAL_LOOKBACK_BLOCKS=2000
USDT_RECONCILIATION_INTERVAL_MS=300000

# --- Cloudinary — payment screenshot uploads (UPI claims and the USDT "I
# already paid" claim form). Not required for USDT deposits to work — a
# failed/missing upload just lets the user submit their tx hash without a
# screenshot — but leaving this empty means screenshots silently never work.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- First-withdrawal hold with cancel window ---
# A user's FIRST-EVER withdrawal, placed within FIRST_WITHDRAWAL_WINDOW_HOURS
# of their first-ever COMPLETED deposit, lands as HELD and auto-promotes to
# REQUESTED after WITHDRAWAL_HOLD_HOURS. The user may cancel it (money
# refunded to realBalance) until WITHDRAWAL_CANCEL_WINDOW_HOURS have elapsed.
WITHDRAWAL_HOLD_HOURS=36
WITHDRAWAL_CANCEL_WINDOW_HOURS=12
FIRST_WITHDRAWAL_WINDOW_HOURS=48

# --- VPN / proxy blocking (apps/web/src/lib/network-guard) ---
# off   = never checks (default; dev/CI)
# log   = checks and logs security.vpn_detected, but lets everyone in
# block = refuses every IP-hiding network (VPN, proxy, Tor, datacenter AND
#         iCloud Private Relay / WARP) with a 403 / redirect to /network-blocked
# Production should run `block`. The same lookup also fills a user's country
# (for the region-only leaderboard) on sign-in when they haven't set one.
# Checks run locally against free public lists (Apple Private Relay, Tor exits,
# X4BNet VPN/datacenter ranges, ip-location-db countries) that the web server
# downloads at boot and refreshes daily — no API key, no per-lookup cost.
VPN_BLOCK_MODE=block
# Optional paid second opinion from ipapi.is for addresses the free lists call
# clean. Leave empty to never contact ipapi.is.
IPAPI_KEY=

# Shared runtime trading mode for web and engine. Both must be set together —
# TRADING_MODEL switches the engine's CFD desk path; NEXT_PUBLIC_TRADING_MODEL
# swaps the web ticket to the CFD UI (chart SL/TP brackets land in PR #104).
# Rebuild the web app after flipping NEXT_PUBLIC_* so the client bundle sees it.
TRADING_MODEL=CFD
NEXT_PUBLIC_TRADING_MODEL=CFD

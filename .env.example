# Postgres — local Homebrew service (port 5433 — see docs/superpowers/plans/README.md
# for why this isn't the default 5432)
DATABASE_URL="postgresql://asm_app:asm_dev_password@localhost:5433/asm_trade?schema=public"
DATABASE_MIGRATE_URL="postgresql://asm_owner:asm_dev_password@localhost:5433/asm_trade?schema=public"

# Redis — local Homebrew service
REDIS_URL="redis://localhost:6379"

# Sessions
SESSION_SECRET="change-me-32-bytes-minimum-for-local-dev-only"

# Feed selection — see Plan 05. Only "simulated" is ever configured.
BANK_FEED="simulated"

NODE_ENV="development"
LOG_LEVEL="info"

# Bank-feed relay ingestion — shared secret the companion app's Bearer token
# must match. Read directly via process.env (not piped through @asm/config),
# since it's specific to this one feature.
SMS_RELAY_SECRET="change-me-in-.env"

# Admin panel — shared secret gate, independent of the user `role` field.
# Read directly via process.env (not piped through @asm/config), same
# pattern as SMS_RELAY_SECRET, since it's specific to this one feature.
ADMIN_PANEL_SECRET="change-me-in-.env"

# Twelve Data — optional. Unset means the bundled replay dataset is used.
# Free tier: 8 requests/minute, 800/day. https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=""

ENGINE_WS_PORT="4001"
NEXT_PUBLIC_ENGINE_WS_URL="ws://localhost:4001"

# Engine loopback control surface (Plan 03). The web app opens trades through it.
ENGINE_HTTP_PORT="4002"
ENGINE_HTTP_URL="http://127.0.0.1:4002"
# Shared secret between the web app and the engine. Generate: openssl rand -base64 32
ENGINE_INTERNAL_SECRET="change-me-in-.env"

# Bot crowd (Plan 04) — simulated traders that keep the book exposed.
BOTS_ENABLED="true"
BOT_COUNT="40"
BOT_ARRIVALS_PER_MINUTE="90"

# Live account gate. Only "true" exposes the live account switcher; anything
# else keeps the client pinned to the demo account and shows a "coming soon"
# dialog if the user tries to switch. Read at build time (NEXT_PUBLIC_*) so
# the client bundle sees it — rebuild after flipping.
NEXT_PUBLIC_LIVE_ACCOUNT_ENABLED="false"

# Public site origin (no trailing slash). Drives canonical URLs, OpenGraph,
# sitemap and JSON-LD. Defaults to https://asmtrader.com when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Search Console "HTML tag" verification token. Renders a <meta> tag
# (no script, CSP-safe). Leave empty if verifying via DNS instead.
NEXT_PUBLIC_GSC_VERIFICATION=""

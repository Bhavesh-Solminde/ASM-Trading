# Postgres — local Homebrew service (port 5433 — see docs/superpowers/plans/README.md
# for why this isn't the default 5432)
DATABASE_URL="postgresql://asm_app:asm_dev_password@localhost:5433/asm_trade?schema=public"
DATABASE_MIGRATE_URL="postgresql://asm_owner:asm_dev_password@localhost:5433/asm_trade?schema=public"

# Redis — local Homebrew service
REDIS_URL="redis://localhost:6379"

# Sessions
SESSION_SECRET="change-me-32-bytes-minimum-for-local-dev-only"

# Feed selection — see Plan 05. Production runs "sms" so the relay APK's
# forwarded UPI messages become the source of truth for deposits; "simulated"
# stays available for local iteration where you don't want to install the
# relay to test the deposit flow end-to-end.
BANK_FEED="sms"

NODE_ENV="development"
LOG_LEVEL="info"

# Bank-feed relay ingestion — shared secret the companion app's Bearer token
# must match. Read directly via process.env (not piped through @asm/config),
# since it's specific to this one feature.
SMS_RELAY_SECRET="change-me-in-.env"

# INR (UPI) collection — read per request by apps/web, so changing any of
# these needs only a web container recreate, not a deploy.
#   UPI_DEPOSITS_ENABLED  "on" opens UPI deposits to users. Leave off until a
#                         relay phone is forwarding the collection account's
#                         credit SMS — nothing else settles an INR deposit.
#   UPI_COLLECTION_VPAS   comma-separated accounts deposits are paid to (the `pa`
#                         in each QR); each new deposit gets one at random
#   UPI_PAYEE_NAME        shown as the payee in the payer's UPI app (`pn`)
#   UPI_MERCHANT_CODE     `mc` from a merchant account's QR; omit for personal VPAs
UPI_DEPOSITS_ENABLED="off"
# UPI_COLLECTION_VPAS="shop1@ybl,shop2@ybl"
# UPI_PAYEE_NAME="ASM Trade"
# UPI_MERCHANT_CODE="5411"

# Admin panel — shared secret gate, independent of the user `role` field.
# Read directly via process.env (not piped through @asm/config), same
# pattern as SMS_RELAY_SECRET, since it's specific to this one feature.
ADMIN_PANEL_SECRET="change-me-in-.env"

# Twelve Data — optional. Unset means the bundled replay dataset is used.
# Free tier: 8 requests/minute, 800/day. https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=""

ENGINE_WS_PORT="4001"
NEXT_PUBLIC_ENGINE_WS_URL="ws://localhost:4001"

# Engine loopback control surface (Plan 03). The web app opens trades through it.
ENGINE_HTTP_PORT="4002"
ENGINE_HTTP_URL="http://127.0.0.1:4002"
# Shared secret between the web app and the engine. Generate: openssl rand -base64 32
ENGINE_INTERNAL_SECRET="change-me-in-.env"

# Bot crowd (Plan 04) — simulated traders that keep the book exposed.
BOTS_ENABLED="true"
BOT_COUNT="40"
BOT_ARRIVALS_PER_MINUTE="90"

# Live account gate. Only "true" exposes the live account switcher; anything
# else keeps the client pinned to the demo account and shows a "coming soon"
# dialog if the user tries to switch. Read at build time (NEXT_PUBLIC_*) so
# the client bundle sees it — rebuild after flipping.
NEXT_PUBLIC_LIVE_ACCOUNT_ENABLED="false"

# Public site origin (no trailing slash). Drives canonical URLs, OpenGraph,
# sitemap and JSON-LD. Defaults to https://asmtrader.com when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Search Console "HTML tag" verification token. Renders a <meta> tag
# (no script, CSP-safe). Leave empty if verifying via DNS instead.
NEXT_PUBLIC_GSC_VERIFICATION=""

# Resend — transactional email (withdrawal reward certificate). Until
# RESEND_API_KEY is set the app runs unchanged and simply skips sending; the
# in-app certificate still shows. RESEND_FROM must be a verified sender/domain
# in your Resend account (defaults to Resend's onboarding@resend.dev sandbox).
RESEND_API_KEY=""
RESEND_FROM="ASM Trade <onboarding@resend.dev>"

# ── USDT deposit provider ──────────────────────────────────────────────────
# "tatum" (default when unset) = the Tatum payment gateway: every deposit gets
# its OWN address derived from an HD-wallet xpub, detected via Tatum webhook +
# engine poller (packages/tatum, apps/engine/src/tatum-runner.ts).
# "manual" = the original shared-address + unique-amount flow configured by
# the USDT_* chain-watcher vars below (kept intact, off by default).
# See docs/superpowers/specs/2026-10-05-tatum-usdt-gateway-design.md.
USDT_DEPOSIT_PROVIDER="tatum"

# Tatum gateway. A network is offered only when EVERY var it needs is valid;
# otherwise it is hidden. Tatum keys start with "t-" on BOTH networks, so the
# engine asks Tatum which network the key serves and idles the gateway poller
# (evt tatum.network_mismatch) if it is not TATUM_NETWORK.
TATUM_API_KEY=""
# Exactly "testnet" or "mainnet" — never defaulted. Tatum's TRON testnet is Shasta.
TATUM_NETWORK=""
# HD-wallet extended PUBLIC keys (xpub) — never a mnemonic or private key.
# Generate with GET /v3/tron/wallet and GET /v3/bsc/wallet (or offline) and
# keep the mnemonics OFF this server; they are only needed to sweep funds.
TATUM_TRON_XPUB=""
# USDT TRC-20 contract (base58). Mainnet: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t.
# Shasta testnet: TG3XXyExBkPp9nzdajDZsozEu4BkaSJozs.
TATUM_TRON_USDT_CONTRACT=""
TATUM_BSC_XPUB=""
# USDT BEP-20 contract. Mainnet: 0x55d398326f99059fF775485246999027B3197955 (18
# decimals). BSC testnet: 0x337610d27c682e347c9cd60bd4b3b107c9d34ddd (18).
TATUM_BSC_USDT_CONTRACT=""
TATUM_BSC_USDT_DECIMALS=""
# Public https URL Tatum POSTs alerts to (https://<host>/api/webhooks/tatum).
# Leave empty on localhost — the engine poller then does all detection.
TATUM_WEBHOOK_URL=""
# Required with TATUM_WEBHOOK_URL. Register it once per API key:
#   pnpm --filter @asm/tatum setup
TATUM_WEBHOOK_HMAC_SECRET=""
# Free Tatum plans allow 3 requests/second; raise on a paid plan.
TATUM_MAX_RPS="3"
# Treasury (sweep target) addresses for the follow-up sweep script — funds
# land on per-deposit addresses and must be swept here (needs the mnemonic
# and TRX/BNB for gas; NOT done by this server).
TATUM_TREASURY_TRON_ADDRESS="TL5cUNhJjPSmyZVDncznin7FrSTtea6zUG"
TATUM_TREASURY_BSC_ADDRESS="0x15e770A42b41f2606538505839042ddFEBACB590"

# USDT (TRC-20) chain watcher — apps/engine/src/chain-watcher. Read directly
# via process.env (not piped through @asm/config), same pattern as
# SMS_RELAY_SECRET, since these are specific to this one feature. The
# watcher stays fully idle (schedules nothing, calls no provider method) —
# never partially active — unless every one of USDT_NETWORK,
# USDT_TRONGRID_NETWORK, USDT_RECEIVING_ADDRESS and USDT_TOKEN_CONTRACT is
# set to a valid value. Leave all of these unset for local development —
# that keeps the watcher inert, which is deliberate: there is no default
# receiving address or contract, and none should ever be invented.
#
# Only "tron" is implemented.
USDT_NETWORK=""
# Which TronGrid host the watcher calls. Must be exactly "mainnet" or
# "nile" — anything else (including leaving it unset) keeps the watcher
# idle rather than silently defaulting to mainnet. mainnet resolves to
# https://api.trongrid.io, nile to https://nile.trongrid.io (both verified
# against developers.tron.network/docs/networks). Shasta is not supported.
USDT_TRONGRID_NETWORK=""
# The application's permanent USDT receiving address on the selected
# network. No default — never invent one.
USDT_RECEIVING_ADDRESS=""
# The USDT TRC-20 token contract address on the selected network. No
# default — never invent one. Cross-checked against the contract's own
# decimals() at watcher startup (must equal 6); a mismatch keeps the watcher
# retrying that check indefinitely rather than proceeding.
USDT_TOKEN_CONTRACT=""
# Optional. TronGrid API key, sent as the TRON-PRO-API-KEY header. TronGrid
# allows keyless access at a lower rate limit; recommended for anything
# beyond light testing. https://developers.tron.network/reference/rate-limits
USDT_TRONGRID_API_KEY=""
# Optional — sensible defaults if unset. How often the watcher ticks
# (ingest -> finality -> match), the re-scan overlap window that absorbs any
# ordering/clock slop at the checkpoint floor, and the per-tick page budget
# for catch-up after downtime.
USDT_WATCHER_TICK_INTERVAL_MS="15000"
# Adaptive pacing: the watcher wakes every USDT_WATCHER_TICK_INTERVAL_MS but
# only calls TronGrid when someone is depositing (an open/just-expired USDT
# deposit, or a transfer still confirming). With no deposit activity it calls
# TronGrid at most once per this interval — still often enough to catch late
# or unexpected payments. The per-wake activity check is a DB query only.
USDT_WATCHER_IDLE_INTERVAL_MS="120000"
USDT_OVERLAP_MS="600000"
USDT_MAX_PAGES_PER_TICK="50"
# The production-activation safety gate. Must be exactly "true" for the
# match/credit stage to run at all — ingestion and finality run regardless
# once configured, but nothing is ever credited unless this is explicitly
# set. Leave unset/false for observation-only testing.
USDT_AUTO_CONFIRM_ENABLED="false"

# USDT on BNB Smart Chain (BEP-20) — a second, independent watcher next to the
# TRON one. It stays fully idle (and the network isn't offered to users) unless
# EVERY required value below is set and valid; there are no defaults for any of
# them. USDT_AUTO_CONFIRM_ENABLED and the USDT_WATCHER_* intervals above apply
# to BSC too.
#
# Exactly "97" (BSC testnet) or "56" (BSC mainnet). Anything else keeps BSC
# idle — it never silently defaults to mainnet. Cross-checked at startup
# against the RPC's own eth_chainId.
USDT_BSC_CHAIN_ID=""
# A JSON-RPC endpoint that ALLOWS eth_getLogs. The official bnbchain.org public
# endpoints refuse eth_getLogs on both mainnet and testnet (verified), so use a
# third-party provider. For testnet, https://bsc-testnet-rpc.publicnode.com
# worked without an account at the time of writing (it requires an address
# filter, which the watcher always sends). For mainnet, use a provider account.
USDT_BSC_RPC_URL=""
# The owner's BSC receiving address (0x + 40 hex). No default — never invent one.
USDT_BSC_RECEIVING_ADDRESS=""
# The USDT BEP-20 contract on the selected chain (0x + 40 hex). Mainnet USDT is
# 0x55d398326f99059fF775485246999027B3197955 (verified on-chain: symbol USDT,
# 18 decimals). For testnet, read the faucet token's contract from your wallet.
USDT_BSC_TOKEN_CONTRACT=""
# The contract's decimals — required, no default (18 for mainnet USDT).
# Cross-checked against the contract's own decimals() at startup; a mismatch
# keeps the watcher retrying that check rather than ingesting anything.
USDT_BSC_TOKEN_DECIMALS=""
# Optional. Blocks per eth_getLogs request (providers cap this), and how far
# back the very first scan starts. BSC blocks are ~0.45s, so 2000 ≈ 15 minutes.
USDT_BSC_MAX_BLOCK_RANGE="2000"
USDT_BSC_INITIAL_LOOKBACK_BLOCKS="2000"

# Cloudinary — hosts the payment-screenshot uploads on the deposit checkout
# page. The upload endpoint (POST /api/deposits/[id]/screenshot) does a
# signed server-side upload; the client never sees these credentials. Set
# CLOUDINARY_URL (which encodes all three) OR the three explicit values
# below. Uploads land in the "deposits/" folder with an unguessable
# public_id assigned by Cloudinary.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# First-withdrawal hold with cancel window. A user's first-ever withdrawal
# placed within FIRST_WITHDRAWAL_WINDOW_HOURS of their first-ever COMPLETED
# deposit lands as HELD for WITHDRAWAL_HOLD_HOURS before auto-promoting into
# the admin queue. The user may cancel it (money returns to realBalance)
# until WITHDRAWAL_CANCEL_WINDOW_HOURS have elapsed. All three must be
# positive integers; typos or non-positive values fall back to the defaults
# below rather than silently disabling the hold.
WITHDRAWAL_HOLD_HOURS="36"
WITHDRAWAL_CANCEL_WINDOW_HOURS="12"
FIRST_WITHDRAWAL_WINDOW_HOURS="48"

# --- VPN / proxy blocking (apps/web/src/lib/network-guard) ---
# off   = never checks (default; dev/CI)
# log   = checks and logs security.vpn_detected, but lets everyone in
# block = refuses VPN/proxy/Tor/datacenter networks with a 403 / redirect
VPN_BLOCK_MODE=off
# ipapi.is key: free account = 1,000 lookups/day; credits are $1 per 30k.
# Empty works on ipapi's small anonymous budget, which is not enough for prod.
IPAPI_KEY=

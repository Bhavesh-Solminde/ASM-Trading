SMS_RELAY_SECRET=change-me

# Use Supabase's Connection Pooler string (Transaction mode), not the direct
# db.<ref>.supabase.co host — that one is IPv6-only and unreachable from
# Vercel's serverless functions.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
